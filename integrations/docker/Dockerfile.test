# syntax=docker/dockerfile:1.10
# SPDX-License-Identifier: MIT OR Apache-2.0
# Copyright (c) lapoule.dev
#
# The test suite of the workspace, run inside a BuildKit build: what the Linux
# jobs of .github/workflows/ci.yml run, on the same stack, for a machine that
# can build images but must not compile the workspace itself. The result is a
# directory, not an image.
#
# Do not build this by hand: scripts/test-on-builder.sh makes the context (the
# tracked files of a commit, plus .test-on-builder/: this file
# from the checkout that runs it, and the commands) and passes the
# arguments.
#
# The stack is CI's `test` job's (ubuntu-24.04):
#   - Ubuntu 24.04, pinned by digest, because the Linux image is also the
#     Vulkan driver: the GPU tests render through lavapipe, Mesa's software
#     rasterizer (`mesa-vulkan-drivers libvulkan1`, as CI installs them).
#     Ubuntu 26.04's lavapipe dies with SIGSEGV in tuile-film-gpu's headless
#     and atmosphere tests (ci.yml, the `runs-on` comment): moving this base
#     is a deliberate change, made with the driver it brings.
#   - TUILE_REQUIRE_GPU=1: a GPU test that finds no adapter fails instead of
#     passing empty.
#   - RUSTFLAGS=-D warnings and CARGO_PROFILE_DEV_DEBUG=line-tables-only, as
#     CI sets them; nextest at CI's version, with CI's profile (.config/nextest.toml).
#
# The steps (TEST_STEPS, space-separated; each one's log and exit code in the
# output, every step run past a failure):
#   test    cargo nextest run --profile ci ${CARGO_TEST_ARGS}    (CI: test)
#   doc     cargo test --workspace --doc                         (CI: test)
#   budget  the budget's simulation and properties, in release   (CI: budget-sim)
#   clippy  cargo clippy --workspace --all-targets -D warnings   (CI: lint)
#   wasm    the wasm32 check and clippy of CI's wasm-guard       (CI: wasm-guard)
# then, when the context carries .test-on-builder/commands, each of its lines
# as a step of its own (cmd-1, cmd-2…), run by bash from the workspace root.
#
# Every line of every step is also printed to the build's progress, and the
# tree's changes after each step that made any: a build cut short leaves them
# in the client's build.log (BuildKit keeps at most its step log limit,
# 2 MiB by default, of the one RUN that holds every step).
#
# The output: <step>.log and <step>.exit for each step, junit.xml (the test
# step's nextest report), junit-budget.xml, summary.txt, changes.patch (every
# change the steps made to the tree: blessed references come back that way),
# and exit-code (0, or the first failing step's code).

# The stack is the prebuilt CI image's (integrations/docker/Dockerfile.ci,
# built by scripts/build-ci-images.sh): Ubuntu 24.04, the apt packages of CI's
# jobs, lavapipe, the pinned stable toolchain with clippy and the wasm32
# target, nextest, sccache. Pinned by digest, never by tag: move it with the
# digest `scripts/build-ci-images.sh` printed.
ARG CI_BASE_IMAGE=ghcr.io/lapoule-dev/tuile-ci-builder@sha256:385231a66f99cde3849a626d5144dd5ef474db6e08e1013498648227fe7305d7
FROM ${CI_BASE_IMAGE} AS base

# CARGO_HOME in one shared cache mount (`id=tuile-cargo-home`): the registry,
# the git checkouts AND cargo's own download lock (`$CARGO_HOME/.package-cache`)
# live together, so two runs on one builder fetching the same crate or git
# dependency wait on cargo's lock instead of racing (a checkout left without
# its Cargo.toml broke every later run). The tools are the image's, in
# /usr/local/bin (rustup's proxies, cargo-nextest, sccache).
ENV CARGO_HOME=/cargo-home CARGO_TERM_COLOR=never CARGO_NET_GIT_FETCH_WITH_CLI=true \
    RUSTFLAGS="-D warnings" CARGO_PROFILE_DEV_DEBUG=line-tables-only \
    TUILE_REQUIRE_GPU=1

FROM base AS test
WORKDIR /repo
COPY . .

# The slot of the builder this run holds: one target directory per slot, so
# two runs at once never share one (two trees in one target dir thrash it and
# wait on its lock). Without a scheduler, slot 0.
ARG TARGET_SLOT=0
ARG CARGO_TEST_ARGS="--workspace"
ARG TEST_STEPS="test doc budget clippy wasm"
ARG CARGO_JOBS=4
ARG TEST_THREADS=4
ARG SCCACHE_BUCKET=""
ARG SCCACHE_REGION=""
ARG SCCACHE_ENDPOINT=""
ARG SCCACHE_PREFIX=""
# Every step runs, whatever the one before it did; the build itself succeeds
# whenever the steps could be started, so the logs always come out. The
# result is in /out/exit-code, not in the build's status.
RUN --mount=type=secret,id=sccache_key_id \
    --mount=type=secret,id=sccache_secret \
    --mount=type=cache,id=tuile-test-target-${TARGET_SLOT},target=/repo/target \
    --mount=type=cache,id=tuile-cargo-home,target=/cargo-home \
    <<'EOF'
#!/bin/bash
set -u
mkdir -p /out
export CARGO_BUILD_JOBS="${CARGO_JOBS}"
. /usr/local/share/tuile/sccache-env.sh
echo "=== $(rustc --version), $(cargo nextest --version | head -n1)"
echo "=== vulkan: $(ls /usr/share/vulkan/icd.d/ 2>/dev/null | tr '\n' ' ')"
echo "=== mesa: $(dpkg-query -W -f='${Version}' mesa-vulkan-drivers)"
# The tree as it came, in a git directory OUTSIDE the tree (no .git appears in
# /repo for a build script to read): what the steps change is diffed against it.
# The commands leave the tree first: they are not part of what is tested.
if [ -f .test-on-builder/commands ]; then mv .test-on-builder/commands /tmp/commands; fi
rm -rf .test-on-builder
# The tree is newer than anything in the target cache. `git archive` dates
# every file by its commit and COPY keeps those dates, while the target
# directory is shared by every run of this slot: a commit older than the last
# build of a crate would look fresh to cargo, which would run the previous
# run's binary for it. Touched here, inside the run that mounts the cache (a
# layer of its own would be cached with the old dates).
find /repo -path /repo/target -prune -o -type f -print0 | xargs -0 touch
snap() { git --git-dir=/tmp/tree.git --work-tree=/repo -c core.autocrlf=false "$@"; }
snap init -q && snap add -A && snap -c user.name=t -c user.email=t@t commit -qm tree \
    || echo "=== no snapshot of the tree: changes.patch will be missing"
first_rc=0
step() { # $1=name, then the commands, run by bash -c
    local name="$1" rc
    shift
    echo "=== ${name}: start $(date +%T)" | tee "/out/${name}.log"
    # Each line also goes to the build's progress, as `|name| line`: the client
    # keeps it in build.log as it comes, so a build cut short (its output never
    # exported) still leaves its logs (scripts/test-on-builder.sh recovers them).
    bash -c "$*" < /dev/null 2>&1 | tee -a "/out/${name}.log" | sed -u "s/^/|${name}| /"
    rc=${PIPESTATUS[0]}
    echo "$rc" > "/out/${name}.exit"
    echo "=== ${name}: exit ${rc} $(date +%T)" | tee -a "/out/${name}.log" | tee -a /out/summary.txt
    grep -E "Summary \[|^test result|^error(\[E[0-9]+\])?:|FAIL \[|TIMEOUT \[|SIGSEGV|panicked" "/out/${name}.log" \
        | sort | uniq -c | sort -rn | sed -n 1,30p | sed "s/^/[${name}] /" | tee -a /out/summary.txt
    [ "$first_rc" -ne 0 ] || first_rc=$rc
    # And the tree's changes so far, when there are any: gzip, base64, between
    # markers, recovered the same way. The last block is the whole patch.
    if snap add -A 2>/dev/null && ! snap diff --cached --quiet 2>/dev/null; then
        echo "=== patch-begin ${name}"
        snap diff --cached --binary | gzip -9 | base64 -w 76
        echo "=== patch-end ${name}"
    fi
}
for s in ${TEST_STEPS}; do
    case "$s" in
        test)
            step test "cargo nextest run --profile ci --test-threads ${TEST_THREADS} ${CARGO_TEST_ARGS}"
            cp target/nextest/ci/junit.xml /out/junit.xml 2>/dev/null ;;
        doc)
            step doc "cargo test --workspace --doc" ;;
        budget)
            step budget "PROPTEST_CASES=10000 cargo nextest run --profile ci --cargo-profile release -p tuile-budget --test budget_sim --test budget_properties --test budget_core --test budget_signals \
                && cp target/nextest/ci/junit.xml /out/junit-budget.xml \
                && PROPTEST_CASES=10000 cargo nextest run --profile ci --cargo-profile release -p tuile-core --test budget_imagery" ;;
        clippy)
            step clippy "cargo clippy --workspace --all-targets -- -D warnings" ;;
        wasm)
            step wasm "cargo check --target wasm32-unknown-unknown -p tuile-budget -p tuile-ground -p tuile-core -p tuile-web -p tuile-wgpu -p tuile-planetary -p tuile-terrain -p tuile-camera -p tuile-atmosphere -p tuile-film-gpu -p tuile-ui -p tuile-film -p tuile-bevy \
                && cargo clippy --target wasm32-unknown-unknown -p tuile-viewer -p tuile-web -p tuile-wgpu -p tuile-bevy -- -D warnings \
                && cargo clippy --target wasm32-unknown-unknown -p tuile-bevy-viewer --features webgpu -- -D warnings \
                && cargo clippy --target wasm32-unknown-unknown -p tuile-bevy-viewer --features webgl2 -- -D warnings" ;;
        *)
            echo "=== unknown step '${s}'" | tee -a /out/summary.txt
            [ "$first_rc" -ne 0 ] || first_rc=2 ;;
    esac
done
if [ -f /tmp/commands ]; then
    n=0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        n=$((n + 1))
        echo "cmd-${n}: ${line}" >> /out/commands.txt
        step "cmd-${n}" "$line"
    done < /tmp/commands
fi
snap add -A 2>/dev/null && snap diff --cached --binary > /out/changes.patch 2>/dev/null
echo "=== changes: $(snap diff --cached --stat 2>/dev/null | tail -n1)" | tee -a /out/summary.txt
tuile_sccache_stop > /out/sccache.txt 2>&1
echo "$first_rc" > /out/exit-code
echo "=== tests: exit ${first_rc} $(date +%T)"
EOF

FROM scratch
COPY --from=test /out /
