#
# Tuile's configuration file. Make a copy of it (any name ending in
# `.tuile`), put your own Cesium ion access token below, and open the copy
# in the application — see docs/try-tuile.md. Opening it once sets
# everything up: the token goes to the system's secure storage (the Keychain
# on a Mac or an iPhone, the Keystore on Android) and the rest to the
# application's settings.
#
# This is TOML (https://toml.io). Lines starting with # are comments.
# Your copy holds your token: keep it to yourself. `*.tuile` files are
# ignored by git in this repository, except the examples.

[ion]
# Required. Your access token, from https://ion.cesium.com/tokens
# — a token with the default `assets:read` scope is enough.
token = "YOUR-ION-TOKEN"

# Optional. The service's API base; the public service by default.
# api = "https://api.cesium.com/"

# Optional. The terrain's asset id: 1 is Cesium World Terrain.
# terrain = 1

# Optional. The imagery layers, in the order the application offers them
# (the I key, the Imagery menu). Leave them out to keep the application's
# own three. Every layer is an asset your token can read; its attribution
# is shown on screen for as long as the layer is.
#
# [[ion.imagery]]
# key = "aerial"
# name = "Aerial"
# asset = 2
# attribution = "© Microsoft and its data suppliers"
#
# [[ion.imagery]]
# key = "satellite"
# name = "Satellite"
# asset = 3954
# attribution = "Contains modified Copernicus Sentinel data"
#
# A layer can also come from any tile server, by its URL template
# ({z}/{x}/{y}, row 0 at the north edge; PNG, JPEG or WebP). With a
# `substitute` on another layer, that layer's far tiles are drawn from this
# one (docs/explorations/imagery-layer-substitution.md). Its token, if the
# server wants one, goes to secure storage like the others.
#
# [[ion.imagery]]
# key = "aerial-far"
# name = "Aerial, far levels"
# template = "https://tiles.example/aerial/{z}/{x}/{y}.webp"
# max_level = 18                   # the deepest level it serves
# attribution = "© Microsoft and its data suppliers"
# token = "YOUR-TILE-TOKEN"        # optional: kept in secure storage
# token_header = "Authorization"   # optional: sent as a bearer by default
#
# A server that hands out a token that runs out (a visitor's, for a day)
# can be named instead of a token: the application asks it for one, keeps
# it in memory only and asks again before it runs out or when it is refused.
# Replace `token` above with `token_url` (the issuer's address) and
# `token_cookie` (the cookie's name), or `token_field` for a JSON answer.

# Optional. Where the first session opens, in the command line's units:
# degrees, metres above the ground, degrees from north, degrees below the
# horizon. A flag on the command line wins over these.
# [start]
# lon = 6.86
# lat = 45.83
# altitude = 6000
# heading = 120
# pitch = 25

# Optional. Send the application's performance numbers (frame times, the
# graphics budget, tile requests; CPU profiles on a desktop) to a collector
# of your choosing, over OTLP/HTTP. Nothing is sent without an endpoint.
# Never sent: where you look, where you are, anything about you. The
# Telemetry menu switches it off and on.
# [telemetry]
# endpoint = "https://collector.example/otlp"
# token = "YOUR-INGEST-TOKEN"      # kept in secure storage, sent as a bearer
# interval = 15                    # seconds between two pushes
# environment = "beta"
# profiling_endpoint = "https://collector.example/pyroscope"
# profiling = "on"                 # or "off": offered in the menu, not started
# profiling_hz = 100
